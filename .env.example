# Database (MongoDB connection string)
DATABASE_URL=mongodb+srv://...

# Dashboard login (defaults exist in code if unset – set in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend (optional – for internal notification when someone registers)
RESEND_API_KEY=
NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=

# SMTP – GoDaddy classic often smtpout.secureserver.net + 465 (SSL) or 587 (TLS). SMTP_USER = full email. Avoid wrapping SMTP_PASS in quotes unless the password contains spaces.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: unset (try PLAIN then LOGIN on 535), LOGIN, or PLAIN (no LOGIN fallback).
SMTP_AUTH_METHOD=
SMTP_FROM=
# Optional display name after "Warm regards" in the registration confirmation email
SMTP_SIGNOFF_NAME=

# Site URL for links/images in emails (e.g. https://yoursite.com or https://xxx.vercel.app). Optional; Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=

# Optional 6-character promo code for registration (if set, users can enter it for validation)
PROMO_CODE=

# Dashboard: allow deleting email blast history entries (default false)
EMAIL_BLAST_DELETE_ENABLED=

# Dashboard: show "Send as test email only" and allow test sends (default false)
EMAIL_BLAST_TEST_ENABLED=

# Email blast subject line (optional; default used if empty)
EMAIL_BLAST_SUBJECT=

# Dashboard: show/hide Email Blast menu and block /api/email-blasts when false
# Default: hidden/disabled (set true to enable)
EMAIL_BLAST_ENABLED=

# Partner inquiry emails (Resend); optional defaults in code
PARTNER_INQUIRY_TO=
PARTNER_INQUIRY_FROM=

# Footer developer contact form (Resend); defaults to asriidev@gmail.com
DEVELOPER_CONTACT_TO=
DEVELOPER_CONTACT_FROM=

# Users dashboard: allow deleting users from the table (default false)
DELETE_USER_ENABLED=

# Registrants dashboard: show per-row Send email action and allow /api/users/[id]/send-email (default false)
REGISTRANT_SEND_EMAIL_ENABLED=

# Registrants dashboard: show "All emails" button (comma-separated list; uses current filters; default false)
REGISTRANTS_EXPORT_ALL_EMAILS_ENABLED=

# Home page: Baguio leg promo splash (30s overlay; set true to show)
PROMO_BAGUIO_LEG=
